@using Microsoft.JSInterop;

@model List<SiteCDL.Models.Post>

@{
     string cabecalho = (ViewBag.categoria != null ? ViewBag.categoria :Model.FirstOrDefault().PostCategoria.Nome);                                                  


    string urlPaginacao = "";
    var httpContext = ViewContext.HttpContext;

    if (httpContext != null)
    {
        if (httpContext.Request != null)
        {
            urlPaginacao = httpContext.Request.Scheme + "://" + httpContext.Request.Host + httpContext.Request.Path;
        }
    }

    object obj = new
    {
        QuantidadeLinhas = Model[0].QuantidadeLinhas,
        Previous = Model[0].Previous,
        PageNumber = Model[0].PageNumber,
        TotalPages = Model[0].TotalPages,
        Next = Model[0].Next,
        PageSize = Model[0].PageSize,
        UrlPaginacao = urlPaginacao
    };

     ViewBag.Route = (ViewBag.categoria == "Publicações" ? "" : Model.FirstOrDefault().PostCategoria.Route);

    ViewData["Title"] = cabecalho;

    var i = 0;
}

@await Html.PartialAsync("Cabecalho", cabecalho)

<section>
    <div class="container container-post">

        <div class="row mt-3 mb-4">

         
            <h4 style="color:#05286b">@cabecalho<br />  <span style="font-size:14px">Página @Model[0].PageNumber</span></h4>
            <hr />
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6 mb-1-9 mb-lg-0">
                    <a href="/publicacoes/@item.PostCategoria.Route/@item.Slug">
                        <article class="card border-0 card-style4">
                            <div class="card-img bg-img cover-background theme-overlay" style="min-height: 160px; margin-top: 0px !important; background-color: #0A3484; background-image: url('@(item.Imagem != null && item.Imagem != "" ? "/wp-content/uploads/" + item.Imagem : item.ImagemBase64 != null && item.ImagemBase64 != "" ? item.ImagemBase64 : "/img/no-image.jpg")')"></div>
                            <div class="card-body py-1-0 px-1-0">
                                <span class="d-block mb-3">
                                    <i class="fas fa-calendar-alt text-primary mr-1" aria-hidden="true"></i> @Convert.ToDateTime(item.Data).Day de @Convert.ToDateTime(item.Data).ToString("MMMM") de @Convert.ToDateTime(item.Data).Year
                                </span>
                                <h3 class="h5 mb-0">
                                    @if (item.PostCategoria != null && item.PostCategoria.Controller != null && item.Slug != null)
                                    {
                                             @Html.Raw(item.Titulo)
                                     }
                                </h3>
                                     <p class="card-text mt-4 mb-2">@Html.Raw((item.Subtitulo != null ? (item.Subtitulo.Length > 150 ? item.Subtitulo.Substring(0, 150) + "..." : item.Subtitulo) : ""))</p>

                                 @if (item.PostCategoria != null && item.PostCategoria.Controller != null && item.Slug != null)
                                {
                                         <p>
                                            <span class="mr-2">Leia Mais</span><i class="fa fa-plus text-primary"></i>
                                        </p>
                                 }
                            </div>
                            <div class="card-footer bg-white px-0 mx-2-0 d-flex py-1-6 justify-content-between">
                                <span class="text-primary">
                                    <i class="fa fa-tags mr-1" aria-hidden="true"></i> @item.PostCategoria.Nome
                                </span>
                            </div>
                        </article>
                    </a>
                </div>

                i++;

                if (i == 4)
                {
                    <div class="col-lg-12 col-md-12 mb-4"></div>
                    i = 0;
                }
            }
        </div>

        @await Html.PartialAsync("../Components/Paginacao", obj)


      
      
                    <h3>Categorias</h3>
            <a asp-controller="publicacoes" asp-action="noticias" class="butn small mt-1">  Notícias</a>
            <a asp-controller="publicacoes" asp-action="cdldireto" class="butn small mt-1">  Opinião</a>
            <a asp-controller="publicacoes" asp-action="comunicados" class="butn small mt-1">  Comunicados</a>
            <a asp-controller="publicacoes" asp-action="cae" class="butn small mt-1">  CAE</a>
            <a asp-controller="publicacoes" asp-action="cdlacao" class="butn small mt-1">  CDL Ação</a>
            <a asp-controller="publicacoes" asp-action="pesquisas" class="butn small mt-1">  Pesquisas</a>
        
    </div>
</section>



