@model List<SiteCDL.Models.Post>
@*
    Lista de publicações (modelo "lista" do protótipo).
    Dados e paginação vêm da API como antes: post/{route}/page/{pagina} ou post/page/{pagina}.
*@
@{
    var primeiro = Model?.FirstOrDefault();
    string cabecalho = ViewBag.categoria ?? primeiro?.PostCategoria?.Nome ?? "Publicações";
    string rotaAtual = ViewBag.categoria == "Publicações" ? "" : (primeiro?.PostCategoria?.Route ?? "");
    ViewBag.Route = rotaAtual;
    ViewData["Title"] = cabecalho;

    var req = ViewContext.HttpContext.Request;
    string urlPaginacao = req.PathBase + req.Path;

    object paginacao = primeiro == null ? null : new
    {
        QuantidadeLinhas = primeiro.QuantidadeLinhas,
        Previous = primeiro.Previous,
        PageNumber = primeiro.PageNumber,
        TotalPages = primeiro.TotalPages,
        Next = primeiro.Next,
        PageSize = primeiro.PageSize,
        UrlPaginacao = urlPaginacao
    };
    int pagina = primeiro?.PageNumber ?? 1;

    var categorias = new[] {
        ("noticias", "Notícias"), ("cdldireto", "Opinião"), ("comunicados", "Comunicados"),
        ("cdlacao", "CDL em Ação"), ("pesquisas", "Pesquisas"), ("cae", "CAE")
    };
}

<section class="lhero" id="hero">
    <div class="wrap">
        <nav class="crumb" aria-label="Você está em">
            <ol>
                <li><a href="/">Início</a></li>
                @if (rotaAtual != "")
                {
                    <li><a href="/publicacoes">Publicações</a></li>
                }
                <li aria-current="page">@cabecalho</li>
            </ol>
        </nav>
        <div class="lhead rv">
            <div>
                <h1>@cabecalho</h1>
                @if (pagina > 1) {<p class="lead">Página @pagina</p>}
            </div>
        </div>
        <div class="lbar rv d1">
            <nav class="cats" aria-label="Categorias">
                @if (rotaAtual == "") {<a href="/publicacoes" aria-current="page">Todas</a>} else {<a href="/publicacoes">Todas</a>}
                @foreach (var (rota, nome) in categorias)
                {
                    if (rota == rotaAtual) {<a href="/publicacoes/@rota" aria-current="page">@nome</a>}
                    else {<a href="/publicacoes/@rota">@nome</a>}
                }
            </nav>
            <label class="lsearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg><input type="search" placeholder="Buscar nesta página" aria-label="Buscar nesta página" data-filtro></label>
        </div>
    </div>
</section>

<section class="sec lsec">
    <div class="wrap">
        @if (Model == null || Model.Count == 0)
        {
            <p class="nores">Nenhuma publicação encontrada.</p>
        }
        else
        {
            // Toda página: 1 publicação em destaque + 15 cards (5 linhas completas de 3). A API pagina de 16 em 16.
            @await Html.PartialAsync("_PostCard", Model[0], new ViewDataDictionary(ViewData) { ["destaque"] = true, ["maisRecente"] = pagina == 1 })
            var resto = Model.Skip(1).ToList();
            <div class="posts">
                @foreach (var item in resto)
                {
                    @await Html.PartialAsync("_PostCard", item, new ViewDataDictionary(ViewData) { ["destaque"] = false })
                }
            </div>
            <p class="nores" hidden>Nenhuma publicação desta página corresponde à busca.</p>
            @await Html.PartialAsync("../Components/Paginacao", paginacao)
        }
    </div>
</section>
