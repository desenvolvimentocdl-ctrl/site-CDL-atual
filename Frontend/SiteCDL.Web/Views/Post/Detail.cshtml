@model DetalhePostGeral
@*
    Página de uma publicação (modelo "matéria" do protótipo).
    Dados vêm da API como antes: post/{route}/{slug} -> Noticia + PostsRelacionados.
*@
@{
    var n = Model?.Noticia;
    string categoria = n?.PostCategoria?.Nome ?? "Publicações";
    string route = n?.PostCategoria?.Route ?? "";
    ViewBag.Route = route;
    ViewData["Title"] = n?.Titulo != null ? System.Text.RegularExpressions.Regex.Replace(n.Titulo, "<[^>]+>", "") : categoria;
    if (!string.IsNullOrWhiteSpace(n?.Subtitulo))
    {
        ViewBag.metaDescription = System.Text.RegularExpressions.Regex.Replace(n.Subtitulo, "<[^>]+>", "");
    }

    var req = ViewContext.HttpContext.Request;
    string urlCompleta = req.Scheme + "://" + req.Host + req.Path + req.QueryString;
    string urlEnc = Uri.EscapeDataString(urlCompleta);
    string tituloTxt = (string)ViewData["Title"];
    string shareWhatsapp = "https://api.whatsapp.com/send?text=" + Uri.EscapeDataString(tituloTxt + ": " + urlCompleta);
    string shareFacebook = "https://www.facebook.com/sharer/sharer.php?u=" + urlEnc;
    string shareLinkedin = "https://www.linkedin.com/sharing/share-offsite/?url=" + urlEnc;
    string shareTwitter = "https://twitter.com/intent/tweet?url=" + urlEnc + "&text=" + Uri.EscapeDataString(tituloTxt);

    string img = !string.IsNullOrEmpty(n?.Imagem) ? "/wp-content/uploads/" + n.Imagem
               : !string.IsNullOrEmpty(n?.ImagemBase64) ? n.ImagemBase64 : "";
    string dataLonga = n?.Data != null ? n.Data.Value.ToString("d 'de' MMMM 'de' yyyy") : "";
    string tituloCurto = tituloTxt.Length > 60 ? tituloTxt.Substring(0, 60) + "…" : tituloTxt;
}

@if (n == null)
{
    <section class="sec"><div class="wrap"><p class="nores">Publicação não encontrada. <a href="/publicacoes">Ver todas as publicações</a>.</p></div></section>
}
else
{
<section class="mhero" id="hero">
    <div class="wrap">
        <nav class="crumb" aria-label="Você está em">
            <ol>
                <li><a href="/">Início</a></li>
                <li><a href="/publicacoes">Publicações</a></li>
                <li><a href="/publicacoes/@route">@categoria</a></li>
                <li aria-current="page">@tituloCurto</li>
            </ol>
        </nav>
        <header class="mhead rv">
            <span class="post-meta"><b>@categoria</b>@if (dataLonga != "") {<time datetime="@n.Data.Value.ToString("yyyy-MM-dd")">@dataLonga</time>}</span>
            <h1>@Html.Raw(n.Titulo)</h1>
            @if (!string.IsNullOrWhiteSpace(n.Subtitulo)) {<p class="dek">@Html.Raw(n.Subtitulo)</p>}
        </header>
        @if (img != "")
        {
            <figure class="mcover rv d1"><img src="@img" alt="" decoding="async" onerror="this.parentNode.remove()"></figure>
        }
    </div>
</section>

<section class="sec msec">
    <div class="wrap mgrid2">
        <article class="art art-pub cms rv">
            @if (!string.IsNullOrWhiteSpace(n.LinkFotos))
            {
                <p><a href="@n.LinkFotos" target="_blank" rel="noopener" class="btn btn-success">Confira as fotos</a></p>
            }
            @Html.Raw(System.Net.WebUtility.HtmlDecode(n.Conteudo ?? ""))

            <footer class="art-foot">
                <a href="/publicacoes/@route" class="btn btn-light">← @categoria</a>
                <span class="share-row">
                    <a href="@shareWhatsapp" target="_blank" rel="noopener">WhatsApp</a>
                    <a href="@shareLinkedin" target="_blank" rel="noopener">LinkedIn</a>
                    <a href="@shareFacebook" target="_blank" rel="noopener">Facebook</a>
                    <a href="@shareTwitter" target="_blank" rel="noopener">X</a>
                    <button type="button" data-copiar>Copiar link</button>
                </span>
            </footer>
        </article>

        <aside class="mside">
            <div class="mcta">
                <span class="k">CDL Uberlândia</span>
                <h3>Associe-se <span class="serif">à CDL.</span></h3>
                <p>Se você é empresário, lojista, prestador de serviços ou profissional autônomo de Uberlândia, a CDL está aberta para acolher o seu negócio.</p>
                <a href="/associe-se" class="btn btn-white">Quero me associar <span class="arr">→</span></a>
            </div>
            @if (Model.PostsRelacionados != null && Model.PostsRelacionados.Count > 0)
            {
                <div class="also">
                    <span class="also-t">Veja também</span>
                    @foreach (var r in Model.PostsRelacionados)
                    {
                        <a href="/publicacoes/@route/@r.Slug">
                            @if (r.Data != null) {<time>@r.Data.Value.ToString("d 'de' MMMM 'de' yyyy")</time>}
                            @Html.Raw(r.Titulo)
                        </a>
                    }
                    <a href="/publicacoes/@route" class="also-mais">Veja mais →</a>
                </div>
            }
        </aside>
    </div>
</section>
}
