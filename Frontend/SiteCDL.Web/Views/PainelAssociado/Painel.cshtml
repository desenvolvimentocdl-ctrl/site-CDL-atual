@using SiteCDL.Services
@using SiteCDL.Web.Controllers
@{
    string secao = ViewBag.Secao;
    PainelDemoService.Associado a = ViewBag.Associado;
    var nomeSecao = PainelAssociadoController.Secoes.First(s => s.Id == secao).Nome;
    ViewData["Title"] = nomeSecao + " — Painel do Associado";
    var br = new System.Globalization.CultureInfo("pt-BR");
    string Moeda(decimal v) => v.ToString("C", br);
    string Dt(DateTime d) => d.ToString("dd/MM/yyyy");
    List<LojaItem> agenda = ViewBag.Agenda ?? new List<LojaItem>();
    List<SiteCDL.Models.Post> comunicados = ViewBag.Comunicados ?? new List<SiteCDL.Models.Post>();
    var abertos = a.Boletos.Where(b => b.Status != "Pago").ToList();
    string? ok = TempData["Ok"] as string;
    string primeiroNome = (User.Identity?.Name ?? a.Responsavel).Split(' ')[0];
    string Badge(string s) => s switch { "Pago" or "Concluído" or "Confirmada" or "Respondido" or "Nada consta" => "ok", "Vencido" or "Possui registro" => "alerta", _ => "info" };
    string[] icones = { "M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z", "M20 12v9H4v-9M2 7h20v5H2zM12 21V7M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z",
                        "M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6", "M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z", "M22 10 12 5 2 10l10 5 10-5zM6 12v5c3 2 9 2 12 0v-5",
                        "M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M8 7h4M8 11h4M8 15h4M2 21h20", "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" };
}
@section Head {
    <meta name="robots" content="noindex,nofollow">
    <link rel="stylesheet" href="~/novo/painel.css" asp-append-version="true">
}

<div class="pa-demo-faixa" role="note">Ambiente de <b>demonstração</b> — os dados exibidos são fictícios, exceto cursos, eventos e comunicados.</div>

<section class="pa">
    <div class="wrap pa-grid">
        <aside class="pa-side">
            <div class="pa-perfil">
                <span class="pa-avatar" aria-hidden="true">@a.NomeFantasia.Substring(0, 1)</span>
                <div><b>@a.NomeFantasia</b><small>@a.Cnpj</small><span class="pa-plano">@a.Plano</span></div>
            </div>
            <nav class="pa-nav" aria-label="Seções do painel">
                @for (int i = 0; i < PainelAssociadoController.Secoes.Length; i++)
                {
                    var s = PainelAssociadoController.Secoes[i];
                    <a href="/painel-associado/@s.Id" @(s.Id == secao ? "aria-current=page" : "")><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@icones[i]"/></svg>@s.Nome
                        @if (s.Id == "boletos" && abertos.Count > 0) {<em>@abertos.Count</em>}</a>
                }
            </nav>
            <form method="post" action="/painel-associado/sair">@Html.AntiForgeryToken()<button type="submit" class="pa-sair">Sair do painel</button></form>
        </aside>

        <div class="pa-main">
            <header class="pa-head">
                <div>
                    <nav class="crumb" aria-label="Você está em"><ol><li><a href="/">Início</a></li><li><a href="/painel-associado/inicio">Painel do Associado</a></li>@if (secao != "inicio") {<li aria-current="page">@nomeSecao</li>}</ol></nav>
                    <h1>@(secao == "inicio" ? $"Olá, {primeiroNome}." : nomeSecao)</h1>
                </div>
            </header>
            @if (ok != null) {<p class="pa-ok" role="status">@ok</p>}

@switch (secao)
{
    case "inicio":
        <div class="pa-kpis">
            <a class="pa-card pa-kpi" href="/painel-associado/boletos"><small>Boletos em aberto</small><b>@abertos.Count</b><span>@(abertos.Count > 0 ? "Próximo vencimento " + Dt(abertos.Min(x => x.Vencimento)) : "Tudo em dia")</span></a>
            <a class="pa-card pa-kpi" href="/painel-associado/spc"><small>Consultas SPC restantes</small><b>@a.Spc.Restantes</b><span>de @a.Spc.Contratadas no mês · renova em @Dt(a.Spc.Renovacao)</span></a>
            <a class="pa-card pa-kpi" href="/painel-associado/cursos"><small>Inscrições ativas</small><b>@a.Inscricoes.Count(x => x.Situacao == "Confirmada")</b><span>@a.Inscricoes.Count(x => x.Certificado != null) certificados disponíveis</span></a>
            <div class="pa-card pa-kpi"><small>Associado desde</small><b>@a.AssociadoDesde.Year</b><span>@a.Plano</span></div>
        </div>
        <div class="pa-cols">
            <div class="pa-card">
                <h2>Atalhos</h2>
                <div class="pa-atalhos">
                    <a href="/painel-associado/boletos">2ª via de boleto</a><a href="https://sistema.spc.org.br/spc/controleacesso/autenticacao/entry.action" target="_blank" rel="noopener">Consultar SPC ↗</a>
                    <a href="/painel-associado/beneficios">Meus benefícios</a><a href="/loja/cursos">Inscrever em curso</a>
                    <a href="/painel-associado/atendimento">Abrir solicitação</a><a href="https://api.whatsapp.com/send?phone=@a.ConsultorWhatsapp" target="_blank" rel="noopener">Falar no WhatsApp ↗</a>
                </div>
            </div>
            <div class="pa-card">
                <h2>Próximos cursos e eventos</h2>
                @if (agenda.Count == 0) {<p class="pa-vazio">Nenhum curso ou evento com inscrições abertas.</p>}
                <ul class="pa-lista">
                    @foreach (var e in agenda) {<li><a href="@e.UrlPagina"><b>@e.Titulo</b><small>@e.Tipo · @e.Periodo</small></a></li>}
                </ul>
            </div>
        </div>
        @if (comunicados.Count > 0)
        {
            <div class="pa-card">
                <h2>Comunicados</h2>
                <ul class="pa-lista">
                    @foreach (var c in comunicados) {<li><a href="/publicacoes/@(c.PostCategoria?.Route ?? "comunicados")/@c.Slug"><b>@Html.Raw(c.Titulo)</b>@if (c.Data != null) {<small>@Dt(c.Data.Value)</small>}</a></li>}
                </ul>
            </div>
        }
        break;

    case "beneficios":
        <p class="pa-intro">Como <b>@a.Plano</b>, sua empresa tem acesso a estes benefícios. Clique para ver como usar.</p>
        <div class="pa-benef">
            @foreach (var b in a.Beneficios)
            {
                <a class="pa-card pa-ben" href="@b.Link"><span class="pa-tag">@b.Categoria</span><h3>@b.Titulo</h3><p>@b.Descricao</p><i>Ver benefício →</i></a>
            }
        </div>
        break;

    case "boletos":
        <p class="pa-intro">Mensalidades dos últimos meses. Copie a linha digitável para pagar no app do seu banco.</p>
        <div class="pa-card pa-tabela-wrap">
            <table class="pa-tabela">
                <thead><tr><th>Descrição</th><th>Vencimento</th><th>Valor</th><th>Situação</th><th><span class="sr">Ações</span></th></tr></thead>
                <tbody>
                    @foreach (var b in a.Boletos)
                    {
                        <tr>
                            <td data-r="Descrição">@b.Descricao</td><td data-r="Vencimento">@Dt(b.Vencimento)</td><td data-r="Valor">@Moeda(b.Valor)</td>
                            <td data-r="Situação"><span class="pa-st @Badge(b.Status)">@b.Status</span></td>
                            <td class="pa-acoes">@if (b.LinhaDigitavel != null) {<button type="button" class="btn btn-light pa-mini" data-copiar-texto="@b.LinhaDigitavel">Copiar linha digitável</button>} else {<span class="pa-muted">—</span>}</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="pa-nota">Precisa de ajuda com um pagamento ou de um boleto de outro mês? <a href="/painel-associado/atendimento">Fale com o financeiro</a>.</p>
        break;

    case "spc":
        <div class="pa-cols">
            <div class="pa-card">
                <h2>Seu pacote de consultas</h2>
                <div class="pa-medidor" style="--p:@a.Spc.Percentual"><b>@a.Spc.Usadas</b><span>de @a.Spc.Contratadas usadas</span></div>
                <p class="pa-muted">Restam <b>@a.Spc.Restantes</b> consultas. O pacote renova em @Dt(a.Spc.Renovacao).</p>
                <a class="btn btn-primary" href="https://sistema.spc.org.br/spc/controleacesso/autenticacao/entry.action" target="_blank" rel="noopener">Acessar o SPC <span class="arr">↗</span></a>
            </div>
            <div class="pa-card">
                <h2>Últimas consultas</h2>
                <ul class="pa-lista">
                    @foreach (var c in a.UltimasConsultas) {<li><div><b>@c.Tipo @c.Documento</b><small>@Dt(c.Data)</small></div><span class="pa-st @Badge(c.Resultado)">@c.Resultado</span></li>}
                </ul>
            </div>
        </div>
        <div class="pa-card">
            <h2>Outros serviços SPC</h2>
            <div class="pa-atalhos">
                <a href="/spc-avisa">SPC Avisa</a><a href="/cadastro-positivo">Cadastro Positivo</a><a href="/spc-negociacao">Negociação de débitos</a><a href="/alerta-documento">Alerta de documentos</a>
            </div>
        </div>
        break;

    case "cursos":
        <div class="pa-card">
            <h2>Minhas inscrições</h2>
            <ul class="pa-lista">
                @foreach (var i in a.Inscricoes)
                {
                    <li><div><b>@i.Titulo</b><small>@i.Tipo · @Dt(i.Data)</small></div>
                        @if (i.Certificado != null) {<button type="button" class="btn btn-light pa-mini" data-demo-aviso="O certificado ficará disponível para download quando o painel estiver ligado ao sistema de cursos.">Baixar certificado</button>}
                        else {<span class="pa-st @Badge(i.Situacao)">@i.Situacao</span>}</li>
                }
            </ul>
        </div>
        <div class="pa-card">
            <h2>Inscrições abertas</h2>
            @if (agenda.Count == 0) {<p class="pa-vazio">Nenhum curso ou evento com inscrições abertas no momento.</p>}
            <div class="pa-agenda">
                @foreach (var e in agenda)
                {
                    <div class="pa-ev"><small>@e.Tipo · @e.Periodo</small><b>@e.Titulo</b><div><a class="btn btn-light pa-mini" href="@e.UrlPagina">Detalhes</a><a class="btn btn-primary pa-mini" href="@e.UrlCompra" target="_blank" rel="noopener">@e.TextoCompra</a></div></div>
                }
            </div>
        </div>
        break;

    case "empresa":
        <div class="pa-cols">
            <form class="pa-card pa-form" method="post" action="/painel-associado/empresa">
                @Html.AntiForgeryToken()
                <h2>Dados cadastrais</h2>
                <label>Razão social<input value="@a.Empresa" readonly></label>
                <div class="pa-f2"><label>CNPJ<input value="@a.Cnpj" readonly></label><label>Nome fantasia<input name="fantasia" value="@a.NomeFantasia"></label></div>
                <div class="pa-f2"><label>Responsável<input name="responsavel" value="@a.Responsavel"></label><label>Segmento<input name="segmento" value="@a.Segmento"></label></div>
                <div class="pa-f2"><label>E-mail<input name="email" type="email" value="@a.Email"></label><label>Telefone<input name="telefone" value="@a.Telefone"></label></div>
                <label>Endereço<input name="endereco" value="@a.Endereco"></label>
                <p class="pa-muted">Razão social e CNPJ só podem ser alterados pelo atendimento.</p>
                <button class="btn btn-primary" type="submit">Salvar alterações</button>
            </form>
            <div class="pa-card">
                <h2>Usuários da empresa</h2>
                <ul class="pa-lista">
                    @foreach (var u in a.Usuarios) {<li><div><b>@u.Nome</b><small>@u.Email</small></div><span class="pa-st info">@u.Perfil</span></li>}
                </ul>
                <button type="button" class="btn btn-light pa-mini" data-demo-aviso="Na versão final, aqui você convida um novo usuário por e-mail e escolhe o perfil de acesso.">+ Adicionar usuário</button>
            </div>
        </div>
        break;

    case "atendimento":
        <div class="pa-cols">
            <form class="pa-card pa-form" method="post" action="/painel-associado/atendimento">
                @Html.AntiForgeryToken()
                <h2>Abrir solicitação</h2>
                <label>Assunto
                    <select name="assunto" required><option value="">Selecione</option><option>Financeiro / boletos</option><option>Consultas SPC</option><option>Cursos e eventos</option><option>Benefícios e descontos</option><option>Atualização cadastral</option><option>Outro assunto</option></select>
                </label>
                <label>Mensagem<textarea name="mensagem" rows="5" required placeholder="Descreva como podemos ajudar"></textarea></label>
                <button class="btn btn-primary" type="submit">Enviar solicitação</button>
            </form>
            <div class="pa-card">
                <h2>Seu atendimento</h2>
                <p class="pa-muted">@a.Consultor · seg. a sex., 8h às 18h</p>
                <div class="pa-atalhos">
                    <a href="https://api.whatsapp.com/send?phone=@a.ConsultorWhatsapp" target="_blank" rel="noopener">WhatsApp ↗</a><a href="tel:+553432393400">(34) 3239-3400</a><a href="mailto:comercial@cdludi.org.br">E-mail</a>
                </div>
                <h3 class="pa-h3">Solicitações recentes</h3>
                <ul class="pa-lista">
                    @foreach (var c in a.Chamados) {<li><div><b>@c.Assunto</b><small>@c.Protocolo · @Dt(c.Abertura)</small></div><span class="pa-st @Badge(c.Situacao)">@c.Situacao</span></li>}
                </ul>
            </div>
        </div>
        @if (comunicados.Count > 0)
        {
            <div class="pa-card">
                <h2>Comunicados para associados</h2>
                <ul class="pa-lista">
                    @foreach (var c in comunicados) {<li><a href="/publicacoes/@(c.PostCategoria?.Route ?? "comunicados")/@c.Slug"><b>@Html.Raw(c.Titulo)</b>@if (c.Data != null) {<small>@Dt(c.Data.Value)</small>}</a></li>}
                </ul>
            </div>
        }
        break;
}
        </div>
    </div>
</section>

<script>
document.querySelectorAll('[data-copiar-texto]').forEach(b=>b.addEventListener('click',async()=>{
  try{await navigator.clipboard.writeText(b.dataset.copiarTexto)}catch(e){}
  const t=b.textContent;b.textContent='Copiado ✓';setTimeout(()=>b.textContent=t,1800)}));
document.querySelectorAll('[data-demo-aviso]').forEach(b=>b.addEventListener('click',()=>alert(b.dataset.demoAviso)));
</script>
