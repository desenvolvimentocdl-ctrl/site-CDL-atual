@model dynamic
@* Paginação das listas — mesma lógica do layout antigo, visual novo (classes .pager/.pg do protótipo) *@
@if (Model.QuantidadeLinhas != 0 && Model.QuantidadeLinhas > Model.PageSize)
{
    <nav class="pager rv" aria-label="Paginação">
        @if (Model.Previous == 0)
        {
            <span class="pg pg-dis" aria-hidden="true">←</span>
        }
        else
        {
            <a class="pg" href="@Model.UrlPaginacao?pagina=@Model.Previous" aria-label="Página anterior">←</a>
        }
        @if (Model.TotalPages > 6 && Model.PageNumber > 3)
        {
            <a class="pg" href="@Model.UrlPaginacao?pagina=1">1</a>
            <span class="pg pg-dots">…</span>
        }
        @for (int numberPage = Model.PageNumber - 2; numberPage <= Model.PageNumber + 2 && numberPage <= Model.TotalPages; numberPage++)
        {
            if (numberPage > 0)
            {
                if (Model.PageNumber == numberPage)
                {
                    <a class="pg" href="@Model.UrlPaginacao?pagina=@numberPage" aria-current="page">@numberPage</a>
                }
                else
                {
                    <a class="pg" href="@Model.UrlPaginacao?pagina=@numberPage">@numberPage</a>
                }
            }
        }
        @if (Model.TotalPages > 6 && Model.PageNumber < Model.TotalPages - 2)
        {
            <span class="pg pg-dots">…</span>
            <a class="pg" href="@Model.UrlPaginacao?pagina=@Model.TotalPages">@Model.TotalPages</a>
        }
        @if (Model.PageNumber == Model.TotalPages)
        {
            <span class="pg pg-dis" aria-hidden="true">→</span>
        }
        else
        {
            <a class="pg pg-next" href="@Model.UrlPaginacao?pagina=@Model.Next">Próxima <span>→</span></a>
        }
    </nav>
}
