@model List<SiteCDL.Models.Search>
@*
    Busca do site (/buscar?id=termo) — mesma busca de antes (SearchService: publicações + páginas), visual novo.
*@
@{
    ViewData["Title"] = "Buscar";
    string termo = Context.Request.Query["id"].ToString();
    var meses = new[] { "jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez" };
}

<section class="lhero" id="hero">
    <div class="wrap">
        <nav class="crumb" aria-label="Você está em">
            <ol><li><a href="/">Início</a></li><li aria-current="page">Buscar</li></ol>
        </nav>
        <div class="lhead rv">
            <div>
                <h1>Buscar</h1>
                @if (termo.Length > 2 && Model != null)
                {
                    <p class="lead">@Model.Count resultado@(Model.Count == 1 ? "" : "s") para “@termo”.</p>
                }
            </div>
        </div>
        <form class="lbar rv d1 busca-form" method="get" action="/buscar" role="search">
            <label class="lsearch busca-grande"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg><input type="search" name="id" value="@termo" placeholder="Busque por notícias, serviços, páginas…" aria-label="Termo de busca" minlength="3" required></label>
            <button class="btn btn-primary" type="submit">Buscar <span class="arr">→</span></button>
        </form>
    </div>
</section>

<section class="sec lsec">
    <div class="wrap">
        @if (Model != null && Model.Count > 0)
        {
            <div class="posts">
                @foreach (var item in Model)
                {
                    string url = item.PostCategoria != null ? "/publicacoes/" + item.PostCategoria.Route + "/" + item.Slug : "/" + item.Slug;
                    string img = !string.IsNullOrEmpty(item.Imagem) ? "/wp-content/uploads/" + item.Imagem : (!string.IsNullOrEmpty(item.ImagemBase64) ? item.ImagemBase64 : "");
                    string tipo = item.PostCategoria?.Nome ?? "Página";
                    string sub = item.Subtitulo ?? "";
                    if (sub.Length > 150) { sub = sub.Substring(0, 150) + "…"; }
                    <a class="post rv" href="@url">
                        <span class="post-img @(img == "" ? "noimg" : "")">@if (img != "") {<img src="@img" alt="" loading="lazy" decoding="async" onerror="this.parentNode.classList.add('noimg');this.remove()">}</span>
                        <span class="post-meta"><b>@tipo</b>@if (item.Data != null) {<time>@(item.Data.Value.Day + " " + meses[item.Data.Value.Month - 1] + " " + item.Data.Value.Year)</time>}</span>
                        <h3>@Html.Raw(item.Titulo)</h3>
                        @if (sub != "") {<p>@Html.Raw(sub)</p>}
                    </a>
                }
            </div>
        }
        else if (termo.Length > 2)
        {
            <div class="nores-box rv"><h2>Nenhum resultado encontrado</h2><p>Tente outra palavra, como “SPC”, “certificado” ou “curso”.</p></div>
        }
        else
        {
            <div class="nores-box rv"><h2>O que você procura?</h2><p>Digite pelo menos 3 letras para buscar em notícias, comunicados e páginas do site.</p></div>
        }
    </div>
</section>
