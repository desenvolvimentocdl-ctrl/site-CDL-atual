@using System.Text.Json
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@*
    CDL Mídia — referências Mobbin: Fiasco (cards coloridos por serviço) e Miro (faixa escura com vídeo).
    Destaque do Instagram @@cdlmidiaudi: links dos vídeos em wwwroot/novo/dados/cdl-midia.json (incorporação oficial do Instagram).
    Textos, condições e valores dos planos mantidos da página anterior.
*@
@{
    ViewData["Title"] = "CDL Mídia";
    ViewBag.metaDescription = "CDL Mídia: divulgação da sua empresa nas redes sociais da CDL, no App CDL Uberlândia com cashback, cupons de desconto e webpage. Planos a partir de R$ 105,05.";
    var insta = "https://www.instagram.com/cdlmidiaudi/";
    var posts = new List<string>();
    var arq = Env.WebRootFileProvider.GetFileInfo("novo/dados/cdl-midia.json");
    if (arq.Exists)
    {
        try
        {
            using var st = arq.CreateReadStream();
            using var doc = JsonDocument.Parse(st);
            if (doc.RootElement.TryGetProperty("posts", out var ps) && ps.ValueKind == JsonValueKind.Array)
                foreach (var x in ps.EnumerateArray())
                {
                    var m = System.Text.RegularExpressions.Regex.Match(x.GetString() ?? "", @"^https://www\.instagram\.com/(p|reel)/([A-Za-z0-9_-]+)");
                    if (m.Success) posts.Add($"https://www.instagram.com/{m.Groups[1].Value}/{m.Groups[2].Value}/");
                }
        }
        catch (Exception) { posts.Clear(); }
    }
}

