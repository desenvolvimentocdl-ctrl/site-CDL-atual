<section class="md-insta" id="instagram">
  <div class="wrap">
    <div class="md-insta-in rv">
      <div class="md-insta-txt">
        <span class="md-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x='3' y='3' width='18' height='18' rx='5'/><circle cx='12' cy='12' r='4'/><circle cx='17.5' cy='6.5' r='.6' fill='currentColor'/></svg> Instagram</span>
        <h2>Veja o CDL Mídia <span class="serif">na prática.</span></h2>
        <p>Exemplos de divulgações publicadas no Instagram <b>@@cdlmidiaudi</b>. Sua empresa pode aparecer assim no Feed e nos Stories.</p>
        <a class="btn btn-white" href="@insta" target="_blank" rel="noopener">Seguir @@cdlmidiaudi <span class="arr">↗</span></a>
      </div>
      <div class="md-reels @(posts.Count == 1 ? "um" : "")">
        @foreach (var u in posts.Take(6))
        {
          <div class="md-reel"><blockquote class="instagram-media" data-instgrm-permalink="@(u)?utm_source=ig_embed" data-instgrm-version="14"><a href="@u" target="_blank" rel="noopener">Ver este vídeo no Instagram</a></blockquote></div>
        }
        @if (posts.Count == 0)
        {
          <a class="md-reel-vazio" href="@insta" target="_blank" rel="noopener">Ver os vídeos no Instagram ↗</a>
        }
      </div>
    </div>
  </div>
</section>
@if (posts.Count > 0) { <script async src="https://www.instagram.com/embed.js"></script> }

