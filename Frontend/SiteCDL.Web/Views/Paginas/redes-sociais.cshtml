@using System.Text.Json
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@*
    Redes sociais da CDL Uberlândia (aba "Redes sociais" do menu).
    - YouTube: últimos vídeos lidos sozinhos do feed oficial do canal (Services/YoutubeFeed.cs).
    - Instagram: posts incorporados pelo método oficial do Instagram; os links ficam em wwwroot/novo/dados/redes-sociais.json.
    - Facebook: plugin de página oficial do Facebook (mostra os posts da página).
*@
@{
    ViewData["Title"] = "Redes sociais";
    ViewBag.metaDescription = "Acompanhe a CDL Uberlândia no Instagram, Facebook, YouTube, LinkedIn e X: vídeos, notícias e eventos para o comércio de Uberlândia.";
    var videos = await SiteCDL.Services.YoutubeFeed.Ultimos(6);
    var posts = new List<string>();
    var arq = Env.WebRootFileProvider.GetFileInfo("novo/dados/redes-sociais.json");
    if (arq.Exists)
    {
        try
        {
            using var st = arq.CreateReadStream();
            using var doc = JsonDocument.Parse(st);
            if (doc.RootElement.TryGetProperty("instagramPosts", out var ps) && ps.ValueKind == JsonValueKind.Array)
                foreach (var p in ps.EnumerateArray())
                    if (p.ValueKind == JsonValueKind.String && System.Text.RegularExpressions.Regex.IsMatch(p.GetString() ?? "", @"^https://www\.instagram\.com/(p|reel)/[A-Za-z0-9_-]+/?$"))
                        posts.Add(p.GetString()!.TrimEnd('/') + "/");
        }
        catch (Exception) { posts.Clear(); }
    }
    var ptBR = new System.Globalization.CultureInfo("pt-BR");
}

<section class="phero" id="hero">
  <div class="gridlines"><i></i><i></i><i></i><i></i><i></i></div>
  <div class="glow"></div>
  <div class="wrap">
    <nav class="crumb" aria-label="Você está em"><ol><li><a href="/">Início</a></li><li aria-current="page">Redes sociais</li></ol></nav>
    <div class="phero-grid solo">
      <div class="phero-txt rv">
        <span class="badge"><b>@@cdluberlandia</b> Redes sociais</span>
        <h1>A CDL <span class="serif">nas redes.</span></h1>
        <p class="lead">Vídeos, notícias, cursos e eventos da CDL Uberlândia. Siga e acompanhe onde preferir.</p>
      </div>
    </div>
  </div>
</section>

