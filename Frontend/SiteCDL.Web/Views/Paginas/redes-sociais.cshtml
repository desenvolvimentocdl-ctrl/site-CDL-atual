@if (posts.Count > 0)
{
<section class="sec" id="instagram" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv"><div><span class="eyebrow">Instagram</span><h2>Últimos posts <span class="serif">no Instagram.</span></h2></div><a class="btn btn-light" href="https://www.instagram.com/cdluberlandia/" target="_blank" rel="noopener">Ver perfil ↗</a></div>
    <div class="rs-ig">
      @foreach (var p in posts.Take(9))
      {
        <blockquote class="instagram-media" data-instgrm-permalink="@(p)?utm_source=ig_embed" data-instgrm-version="14"><a href="@p" target="_blank" rel="noopener">Ver este post no Instagram</a></blockquote>
      }
    </div>
  </div>
</section>
<script async src="https://www.instagram.com/embed.js"></script>
}

@if (videos.Count > 0)
{
<section class="sec" id="youtube" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv"><div><span class="eyebrow">YouTube · TV CDL Uberlândia</span><h2>Vídeos <span class="serif">mais recentes.</span></h2></div><a class="btn btn-light" href="https://www.youtube.com/channel/@SiteCDL.Services.YoutubeFeed.CanalId/" target="_blank" rel="noopener">Ver canal ↗</a></div>
    <div class="rs-yt">
      @foreach (var v in videos)
      {
        <a class="rs-vid rv" href="https://www.youtube.com/watch?v=@v.Id" target="_blank" rel="noopener">
          <span class="rs-th"><img src="https://i.ytimg.com/vi/@v.Id/hqdefault.jpg" alt="" loading="lazy" decoding="async"><em aria-hidden="true">▶</em></span>
          <b>@v.Titulo</b>
          @if (v.Publicado > DateTime.MinValue) { <small>@v.Publicado.ToLocalTime().ToString("dd 'de' MMMM 'de' yyyy", ptBR)</small> }
        </a>
      }
    </div>
  </div>
</section>
}

<section class="sec" id="facebook" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv"><div><span class="eyebrow">Facebook</span><h2>Publicações <span class="serif">no Facebook.</span></h2></div><a class="btn btn-light" href="https://www.facebook.com/cdluberlandia" target="_blank" rel="noopener">Ver página ↗</a></div>
    <div class="rs-fb rv">
      <iframe title="Publicações da CDL Uberlândia no Facebook" src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fcdluberlandia&amp;tabs=timeline&amp;width=500&amp;height=720&amp;small_header=false&amp;adapt_container_width=true&amp;hide_cover=false&amp;show_facepile=false" width="500" height="720" style="border:none;overflow:hidden" scrolling="no" frameborder="0" loading="lazy" allow="encrypted-media; picture-in-picture; web-share"></iframe>
    </div>
  </div>
</section>
