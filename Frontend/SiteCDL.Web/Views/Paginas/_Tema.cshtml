@model SiteCDL.Services.HubTemas.Tema
@*
    Página de tema do menu (ex.: /vender-mais). Conteúdo em Services/HubTemas.cs; descrições do GeoCatalogo.
*@
@{
    ViewData["Title"] = Model.Titulo + " " + Model.TituloSerif.TrimEnd('.');
    ViewBag.metaDescription = Model.Intro;
    var grid = Model.Itens.Length % 3 == 0 || Model.Itens.Length == 5 ? "c3l" : (Model.Itens.Length == 4 ? "c4t" : "c3l");
}

<section class="phero" id="hero">
  <div class="gridlines"><i></i><i></i><i></i><i></i><i></i></div>
  <div class="glow"></div>
  <div class="wrap">
    <nav class="crumb" aria-label="Você está em"><ol><li><a href="/">Início</a></li><li><span>@Model.Aba</span></li><li aria-current="page">@ViewData["Title"]</li></ol></nav>
    <div class="phero-grid solo">
      <div class="phero-txt rv">
        <span class="badge"><b>@Model.Aba</b> @Model.Itens.Length @(Model.Itens.Length == 1 ? "serviço" : "serviços")</span>
        <h1>@Model.Titulo <span class="serif">@Model.TituloSerif</span></h1>
        <p class="lead">@Model.Intro</p>
      </div>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <partial name="_CardsTema" model="Model" />
  </div>
</section>

<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="cta-band rv" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding:28px 32px;border-radius:24px;background:var(--blue-50);box-shadow:0 0 0 1px var(--line) inset">
      <p style="margin:0;font-size:17px;font-weight:600;color:var(--ink)">Quer ajuda para escolher? Fale com um consultor da CDL Uberlândia.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="https://wa.me/553432393413" class="btn btn-primary" target="_blank" rel="noopener">Falar com um consultor <span class="arr">→</span></a>
        <a href="/associe-se" class="btn btn-light">Associe-se <span class="arr">→</span></a>
      </div>
    </div>
  </div>
</section>
