@* Produto da Loja (evento/curso da API sem página própria no protótipo). Gerado por gerar_loja.py *@
@model SiteCDL.Web.Controllers.LojaItem

<section class="lhero loja-hero" id="hero">
  <div class="wrap">
    <nav class="crumb" aria-label="Você está em"><ol><li><a href="/">Início</a></li><li><a href="/loja">Loja CDL</a></li><li aria-current="page">@Model.Titulo</li></ol></nav>
    <div class="lhead rv"><div><h1>@Model.Titulo</h1></div>
      <a class="btn btn-light loja-login" href="https://loja.cdludi.org.br/Login" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>Entrar</a></div>
    <nav class="cats loja-abas rv d1" aria-label="Seções da Loja"><a href="/loja">Início da Loja</a><a href="/loja/eventos" @(Model.Tipo == "Evento" ? "aria-current=page" : "")>Eventos</a><a href="/loja/cursos" @(Model.Tipo == "Curso" ? "aria-current=page" : "")>Cursos</a><a href="/loja/cursos-ead">Cursos EAD</a><a href="/loja/descontos">Descontos</a><a href="/loja/parceiros">Parceiros</a><a href="/loja/menor-preco">CDL MenorPreço</a></nav>
  </div>
</section>
<section class="sec lsec"><div class="wrap pgrid2">
  @if (Model.Imagem != "") {<figure class="pp-img rv"><img src="@Model.Imagem" alt="@Model.Titulo" decoding="async"></figure>}
  <aside class="pp-box rv d1"><span class="lc-tag static">@Model.Tipo</span><dl><div><dt>Período</dt><dd>@Model.Periodo</dd></div>@if (Model.Horario != "") {<div><dt>Horário</dt><dd>@Model.Horario</dd></div>}@if (Model.CargaHoraria != "") {<div><dt>Carga horária</dt><dd>@Model.CargaHoraria hrs</dd></div>}@if (Model.Instrutor != "") {<div><dt>Instrutor(a)</dt><dd>@Model.Instrutor</dd></div>}</dl>
    @if (Model.Gratuito) {<p class="lc-preco big"><b class="free">Gratuito</b></p>} else {<p class="lc-preco big"><b>R$ @Model.Valor</b></p>}
    <a class="btn btn-primary" href="@Model.UrlCompra" target="_blank" rel="noopener">@Model.TextoCompra <span class="arr">→</span></a>
    <p class="pp-seg">Pagamento e inscrição no ambiente seguro da Loja CDL.</p></aside>
  <article class="art pp-desc rv"><h2 class="pp-h">Descrição</h2><p>Confira a programação completa, o conteúdo e as condições na <a href="https://loja.cdludi.org.br/Compras/Produto/@Model.Slug" target="_blank" rel="noopener">página do produto na Loja CDL</a>.</p></article>
</div></section>