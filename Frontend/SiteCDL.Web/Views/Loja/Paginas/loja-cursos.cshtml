@*
    loja-cursos — Loja CDL no visual novo (protótipo testesitecdl.netlify.app). Gerado por C:\Projetos\prototipo-ferramentas\gerar_loja.py
    Compra, inscrição e login continuam em loja.cdludi.org.br.
*@
@{
    ViewData["Title"] = "Cursos";
}

<section class="lhero loja-hero" id="hero">
  <div class="wrap">
    <nav class="crumb" aria-label="Você está em"><ol><li><a href="/">Início</a></li><li><a href="/loja">Loja CDL</a></li><li aria-current="page">Cursos</li></ol></nav>
    <div class="lhead rv"><div><h1>Cursos</h1></div>
      <a class="btn btn-light loja-login" href="https://loja.cdludi.org.br/Login" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>Entrar</a></div>
    <nav class="cats loja-abas rv d1" aria-label="Seções da Loja"><a href="/loja">Início da Loja</a><a href="/loja/eventos">Eventos</a><a href="/loja/cursos" aria-current=page>Cursos</a><a href="/loja/cursos-ead">Cursos EAD</a><a href="/loja/descontos">Descontos</a><a href="/loja/parceiros">Parceiros</a><a href="/loja/menor-preco">CDL MenorPreço</a></nav>
  </div>
</section>
<section class="sec lsec"><div class="wrap">
  <div class="lcards">@{ int k = 0; }@foreach (var item in (ViewBag.Itens as List<SiteCDL.Web.Controllers.LojaItem>) ?? new List<SiteCDL.Web.Controllers.LojaItem>()){ ViewData["d"] = k++ % 3; <partial name="~/Views/Loja/_LojaCard.cshtml" model="item" view-data="ViewData" /> }</div>
@if (k == 0) {<p class="nores">Nenhum curso com inscrições abertas no momento. Confira a <a href="https://loja.cdludi.org.br" target="_blank" rel="noopener">Loja CDL</a>.</p>}
</div></section>