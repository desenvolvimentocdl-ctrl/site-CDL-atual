@model ErrorViewModel
@{
    ViewData["Title"] = "Página não encontrada";
}

<section class="phero ihero" id="hero">
    <div class="gridlines"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="glow"></div>
    <div class="wrap">
        <nav class="crumb" aria-label="Você está em">
            <ol><li><a href="/">Início</a></li><li aria-current="page">Página não encontrada</li></ol>
        </nav>
        <div class="ihead rv">
            <span class="badge"><b>Erro 404</b> Página não encontrada</span>
            <h1>Não encontramos <span class="serif">esta página.</span></h1>
            <p class="lead">A página que você procura pode ter sido removida, teve seu nome alterado ou está temporariamente indisponível.</p>
            <div class="ctas" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:28px">
                <a href="/" class="btn btn-primary">Ir para a página inicial <span class="arr">→</span></a>
                <a href="/buscar" class="btn btn-light">Buscar no site</a>
            </div>
        </div>
    </div>
</section>
