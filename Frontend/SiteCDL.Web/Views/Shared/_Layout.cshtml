<script>
  // Fora do site oficial (localhost, IP da rede interna, servidor de teste): a pasta /wp-content/uploads existe
  // apenas no servidor de produção, então as fotos de notícias/banners são buscadas em cdludi.org.br.
  // No próprio cdludi.org.br este código não faz nada.
  if (!/(^|\.)cdludi\.org\.br$/i.test(location.hostname)) addEventListener('error', function (e) {
    var i = e.target; if (i.tagName !== 'IMG' || i.dataset.oficial) return;
    var c = i.getAttribute('src') || ''; if (c.indexOf('/wp-content/uploads/') !== 0) return;
    e.stopPropagation(); i.dataset.oficial = '1'; i.src = 'https://cdludi.org.br' + c;
  }, true);
</script>
<script>
/* Usa a imagem local (img/); se não existir, tenta a do site da CDL; se falhar, esconde e mostra o fallback */
function imgFb(el){if(el.dataset.remote&&!el.dataset.tried){el.dataset.tried=1;el.src=el.dataset.remote;return}
el.style.display='none';var f=el.nextElementSibling;if(f&&f.classList.contains('fb')){f.style.display='';if(f.tagName==='IMG')f.onerror=function(){f.style.display='none';var c=f.closest('.ac-cover');if(c)c.classList.add('noimg')}}}
</script>
<script type="application/ld+json">@Html.Raw(SiteCDL.Services.GeoJsonLd.Montar(geoSite, geoUrl, geoTitulo, geoDescricao, ViewData, geoHome))</script>

