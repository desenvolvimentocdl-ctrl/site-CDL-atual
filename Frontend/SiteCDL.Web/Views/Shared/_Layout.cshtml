@inject Microsoft.Extensions.Configuration.IConfiguration GeoConfig
@{
    // GEO / SEO: endereço canônico, Open Graph e dados estruturados (ver Services/GeoJsonLd.cs e Controllers/GeoController.cs)
    string geoSite = (GeoConfig["SiteUrl"] ?? SiteCDL.Services.GeoCatalogo.SiteUrlPadrao).TrimEnd('/');
    string geoCaminho = Context.Request.Path.Value ?? "/";
    bool geoHome = geoCaminho == "/" || geoCaminho.Equals("/Home", StringComparison.OrdinalIgnoreCase) || geoCaminho.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase);
    string geoPagina = Context.Request.Query["pagina"].ToString();
    string geoUrl = ViewData["Canonical"] as string
                    ?? geoSite + (geoHome ? "/" : geoCaminho.TrimEnd('/')) + (geoPagina.Length > 0 && geoPagina != "1" ? "?pagina=" + Uri.EscapeDataString(geoPagina) : "");
    string geoTitulo = ViewData["Title"] is string gt && gt.Length > 0 ? gt : "CDL Uberlândia";
    string geoDescricao = ViewBag.metaDescription as string ?? "CDL Uberlândia - Soluções empresariais, plano de saúde, certificação digital, consultas ao SPC e apoio ao comércio local.";
    string geoImagem = ViewData["OgImage"] as string ?? "/img/logo.png";
    if (geoImagem.StartsWith("/")) geoImagem = geoSite + geoImagem;
    bool geoPainel = geoCaminho.StartsWith("/painel-associado", StringComparison.OrdinalIgnoreCase); // o painel já declara noindex,nofollow
    bool geoNoIndex = ViewData["NoIndex"] is true || geoCaminho.StartsWith("/buscar", StringComparison.OrdinalIgnoreCase);
}
