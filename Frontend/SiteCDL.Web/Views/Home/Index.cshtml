@model Home
@*
    Página inicial — visual novo (protótipo desing-novo-site---cdl).
    Gerado por C:\Projetos\prototipo-ferramentas\gerar_home.py. Dados: HomeController (API "home" + API da Loja).
*@
@{
    ViewData["Title"] = "";
    ViewBag.BodyClass = "home";

    var banners = Model?.Banners ?? new List<SiteCDL.Models.Banner>();
    var bannersDesk = banners.Where(b => !string.IsNullOrWhiteSpace(b.CaminhoDesktop)).ToList();
    var bannersMob = banners.Where(b => !string.IsNullOrWhiteSpace(b.CaminhoMobile)).ToList();

    // Link da campanha como foi cadastrado no portal: "uol.com" vira "https://uol.com"; links de outros sites abrem em nova aba.
    // Campanha sem link cadastrado no portal fica só como imagem (sem link "morto" para #campanhas).
    (string href, bool externo)? LinkCampanha(string? link)
    {
        var l = (link ?? "").Trim();
        if (l == "" || l == "#") return null;
        if (l.StartsWith("/") || l.StartsWith("#")) return (l, false);
        if (!System.Text.RegularExpressions.Regex.IsMatch(l, @"^[a-z][a-z0-9+.-]*:", System.Text.RegularExpressions.RegexOptions.IgnoreCase)) l = "https://" + l;
        if (!Uri.TryCreate(l, UriKind.Absolute, out var u) || !(u.Scheme is "http" or "https" or "mailto" or "tel")) return null;
        bool doSite = u.Host.Equals("cdludi.org.br", StringComparison.OrdinalIgnoreCase) || u.Host.Equals("www.cdludi.org.br", StringComparison.OrdinalIgnoreCase);
        return (doSite ? u.PathAndQuery + u.Fragment : u.ToString(), !doSite && u.Scheme.StartsWith("http"));
    }
    Microsoft.AspNetCore.Html.IHtmlContent SlideCampanha(SiteCDL.Models.Banner b, string arquivo)
    {
        var alt = System.Net.WebUtility.HtmlEncode(b.Nome ?? "Campanha CDL");
        var img = $"<img src=\"/wp-content/uploads/banners/{System.Net.WebUtility.HtmlEncode(arquivo)}\" alt=\"{alt}\" loading=\"lazy\" decoding=\"async\">";
        var l = LinkCampanha(b.Link);
        if (l == null) return new Microsoft.AspNetCore.Html.HtmlString($"<div class=\"slide\">{img}</div>");
        var alvo = l.Value.externo ? " target=\"_blank\" rel=\"noopener\"" : "";
        return new Microsoft.AspNetCore.Html.HtmlString($"<a class=\"slide\" href=\"{System.Net.WebUtility.HtmlEncode(l.Value.href)}\"{alvo}>{img}</a>");
    }
    var noticias = Model?.Noticias ?? new List<SiteCDL.Models.Post>();

    // ---------- agenda: Loja (API) + posts das categorias Cursos e Eventos dentro do período ----------
    var agenda = new List<ItemAgenda>();
    string Abs(string u) => string.IsNullOrWhiteSpace(u) ? "" : (u.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || u.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ? u : "https://" + u);
    void DaLoja(IEnumerable<dynamic> lista, string tipo, string campoData)
    {
        if (lista == null) return;
        foreach (var x in lista)
        {
            string landing = Convert.ToString(x.urlLandingPage) ?? "";
            string url = landing != "" ? Abs(landing) : "/loja/produto/" + Convert.ToString(x.slug);
            string ini = Convert.ToString(x[campoData + "Inicio" + tipo]) ?? "";
            string fim = Convert.ToString(x[campoData + "Fim" + tipo]) ?? "";
            string hIni = Convert.ToString(x["horaInicio" + tipo]) ?? "";
            string hFim = Convert.ToString(x["horaFim" + tipo]) ?? "";
            var (dia, mes) = DiaMes(ini, fim);
            string horario = hIni == "" ? "" : (hFim == "" || hFim == hIni ? hIni + "h" : hIni + "h às " + hFim + "h");
            agenda.Add(new ItemAgenda
            {
                Tipo = tipo, Titulo = Convert.ToString(x.titulo) ?? "", Url = url, Dia = dia, Mes = mes,
                Detalhe = string.Join(" · ", new[] { horario, tipo == "Curso" ? "Presencial" : "" }.Where(s => s != "")),
                Imagem = SiteCDL.Web.Controllers.LojaController.ImagemServico(Convert.ToString(x.codigo) ?? "", Convert.ToString(x.imagem) ?? "")
            });
        }
    }
    DaLoja(ViewBag.Eventos as IEnumerable<dynamic>, "Evento", "data");
    DaLoja(ViewBag.Cursos as IEnumerable<dynamic>, "Curso", "data");
    void DosPosts(List<SiteCDL.Models.Post> lista, string tipo)
    {
        if (lista == null) return;
        foreach (var p in lista.Where(x => x.DataInicio <= DateTime.Now && x.DataFim >= DateTime.Now))
        {
            agenda.Add(new ItemAgenda
            {
                Tipo = tipo, Titulo = p.Titulo ?? "", Url = !string.IsNullOrWhiteSpace(p.Link) ? Abs(p.Link) : "/publicacoes/cursos/" + p.Slug,
                Dia = "", Mes = "", Detalhe = p.Subtitulo ?? "",
                Imagem = !string.IsNullOrWhiteSpace(p.Imagem) ? "/wp-content/uploads/" + p.Imagem : ""
            });
        }
    }
    DosPosts(Model?.Eventos, "Evento");
    DosPosts(Model?.Cursos, "Curso");
}
@functions {
    public class ItemAgenda { public string Tipo = "", Titulo = "", Url = "", Dia = "", Mes = "", Detalhe = "", Imagem = ""; }

    static readonly string[] Meses = { "jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez" };

    // Datas da Loja chegam como texto (ex.: 16/11/2026). Se não der para ler, mostra o texto como veio.
    (string, string) DiaMes(string ini, string fim)
    {
        var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
        bool okI = DateTime.TryParse(ini, br, System.Globalization.DateTimeStyles.None, out var di);
        bool okF = DateTime.TryParse(fim, br, System.Globalization.DateTimeStyles.None, out var df);
        if (!okI) return (ini, "");
        if (!okF || df.Date == di.Date) return (di.Day.ToString(), Meses[di.Month - 1]);
        if (df.Month == di.Month) return (di.Day + "–" + df.Day, Meses[di.Month - 1]);
        return (di.Day + "/" + di.Month, "a " + df.Day + "/" + df.Month);
    }

    string UrlPost(SiteCDL.Models.Post p) => "/publicacoes/" + (p.PostCategoria?.Route ?? "") + "/" + p.Slug;
    string ImgPost(SiteCDL.Models.Post p) => !string.IsNullOrEmpty(p.Imagem) ? "/wp-content/uploads/" + p.Imagem : (!string.IsNullOrEmpty(p.ImagemBase64) ? p.ImagemBase64 : "");
    string DataCurta(DateTime? d) => d == null ? "" : d.Value.Day + " " + Meses[d.Value.Month - 1] + " " + d.Value.Year;
}

