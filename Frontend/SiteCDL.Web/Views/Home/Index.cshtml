@model Home;
@using Microsoft.AspNetCore.Mvc.Razor;

@{
    ViewData["Title"] = "CDL Uberlândia - Página inicial";
}       
 
<div class="rev_slider_wrapper mt-responsive-carousel desktop"   >
    <div class="rev_slider" id="rev_slider_1" data-version="5.4.5" >
        <ul>
            @if (Model != null && Model.Banners != null && Model.Banners.Count > 0)
            {
                DateTime dataAtual = DateTime.Now;
                int count = 0;

                foreach (var banner in Model.Banners)
                {
                    if (!string.IsNullOrWhiteSpace(banner.CaminhoDesktop)) 
                    {
                        string link = banner.Link != null ? banner.Link : "";

                        <li data-fstransition="fade" data-transition="fade" style="cursor:pointer" onclick="linkBanner('@link')" data-easein="Power4.easeInOut" data-hideslideonmobile="off" data-easeout="Power4.easeInOut" data-slotamount="default" data-masterspeed="300" data-fsmasterspeed="0" data-fsslotamount="0" data-saveperformance="off">
                            <img src="~/wp-content/uploads/banners/@banner.CaminhoDesktop" alt="" data-bgrepeat="no-repeat" data-bgfit="cover" class="rev-slidebg"  />
                        </li>

                        count++;
                    }
                }

                if (count == 0)
                {
                    <li data-fstransition="fade" data-transition="fade" style="cursor:pointer" onclick="linkBanner('https://cdludi.org.br/')" data-easein="Power4.easeInOut" data-hideslideonmobile="off" data-easeout="Power4.easeInOut" data-slotamount="default" data-masterspeed="300" data-fsmasterspeed="0" data-fsslotamount="0" data-saveperformance="off">
                        <img src="/img/no-image.jpg" alt="" data-bgrepeat="no-repeat" data-bgfit="cover" class="rev-slidebg" />
                    </li>
                }
            }
        </ul>
    </div>
</div>
