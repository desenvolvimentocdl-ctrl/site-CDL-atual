<!-- ============ CAMPANHAS (banners cadastrados no portal) ============ -->
@if (bannersDesk.Count > 0 || bannersMob.Count > 0)
{
<section class="camp" id="campanhas">
  <div class="wrap">
    <div class="camp-head rv">
      <div><span class="eyebrow">Em destaque</span><h3>Campanhas da CDL</h3></div>
    </div>
    <div class="camp-stage">
    <button class="cbtn prev" data-dir="-1" aria-label="Anterior">←</button><button class="cbtn next" data-dir="1" aria-label="Próxima">→</button>
    <div class="camp-track desk rv d1">@foreach (var b in bannersDesk) {@SlideCampanha(b, b.CaminhoDesktop!)}</div>
    <div class="camp-track mob rv d1">@foreach (var b in (bannersMob.Count > 0 ? bannersMob : bannersDesk)) {@SlideCampanha(b, string.IsNullOrWhiteSpace(b.CaminhoMobile) ? b.CaminhoDesktop! : b.CaminhoMobile)}</div>
    </div>
    <div class="camp-dots" aria-hidden="true"></div>
  </div>
</section>
}

<!-- ============ SOLUÇÕES (prévia da página /solucoes — grupos em Services/HubTemas.cs) ============ -->
<section class="sec sol-prev" id="solucoes">
  <div class="gridlines"><i></i><i></i><i></i><i></i><i></i></div>
  <div class="wrap">
    <div class="sec-head">
      <div class="rv"><span class="eyebrow">Soluções</span><h2>Ferramentas para a sua empresa <span class="serif">crescer.</span></h2></div>
      <a href="/solucoes" class="btn btn-primary rv d1">Ver todas as soluções <span class="arr">→</span></a>
    </div>
    <div class="sp-grid">
      @{ var spN = 0; }
      @foreach (var slug in new[] { "espacos-para-eventos", "vender-mais", "gestao-e-economia", "pessoas" })
      {
          if (!SiteCDL.Services.HubTemas.Temas.TryGetValue(slug, out var tm)) { continue; }
          spN++;
          var mostra = tm.Itens.Select(x => x.Titulo).ToList();
          <a class="sp-card rv d@(spN - 1)" href="/solucoes#g-@slug" style="--ac:@SiteCDL.Services.HubTemas.Cor(slug)">
            <span class="sp-top"><span class="sp-n">@spN.ToString("00")</span><span class="sp-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(SiteCDL.Services.HubTemas.Icone(tm.Itens[0].Url))</svg></span></span>
            <h3>@tm.Titulo @tm.TituloSerif.TrimEnd('.')</h3>
            <p>@tm.Intro</p>
            <ul>@foreach (var m in mostra) { <li>@m</li> }</ul>
            <span class="sp-go">Ver @tm.Itens.Length @(tm.Itens.Length == 1 ? "solução" : "soluções") <i>→</i></span>
          </a>
      }
    </div>

    @* Banner do CDL MenorPreço saiu da home e foi para Views/Loja/Paginas/loja-menorpreco.cshtml *@
  </div>
</section>

<!-- ============ PUBLICAÇÕES (com imagens, como no site original) ============ -->
<section class="sec" id="publicacoes">
  <div class="wrap">
    <div class="sec-head">
      <div class="rv"><span class="eyebrow">Conteúdo</span><h2>Dados e notícias <span class="serif">do varejo.</span></h2></div>
      <a href="/publicacoes" class="btn btn-light rv d1">Todas as publicações <span class="arr">→</span></a>
    </div>
    <nav class="ncats rv" aria-label="Categorias de publicações"><a href="/publicacoes/noticias">Notícias</a><a href="/publicacoes/cdldireto">Opinião</a><a href="/publicacoes/comunicados">Comunicados</a><a href="/publicacoes/cdlacao">CDL em Ação</a><a href="/publicacoes/pesquisas">Pesquisa</a><a href="/publicacoes/cae">CAE</a></nav>
    <div class="nwrap">
      @if (noticias.Count > 0)
      {
        var f = noticias[0];
        <a class="nf rv" href="@UrlPost(f)"><div class="nimg">@if (ImgPost(f) != "") {<img src="@ImgPost(f)" alt="" loading="lazy" decoding="async" onerror="this.remove()">}<span class="nph" aria-hidden="true"><img src="/novo/img/logo-branco.png" alt=""></span></div><div class="nf-b"><div class="nmeta"><span class="ncat">@(f.PostCategoria?.Nome)</span><time>@DataCurta(f.Data)</time></div><h3>@Html.Raw(f.Titulo)</h3><span class="nmore">Ler matéria <i>→</i></span></div></a>
        <div class="nlist rv d1">
        @foreach (var n in noticias.Skip(1).Take(4))
        {
          <a class="ni" href="@UrlPost(n)"><div class="nimg">@if (ImgPost(n) != "") {<img src="@ImgPost(n)" alt="" loading="lazy" decoding="async" onerror="this.remove()">}<span class="nph" aria-hidden="true"><img src="/novo/img/logo-branco.png" alt=""></span></div><div><div class="nmeta"><span class="ncat">@(n.PostCategoria?.Nome)</span><time>@DataCurta(n.Data)</time></div><b>@Html.Raw(n.Titulo)</b></div></a>
        }
        </div>
      }
    </div>
  </div>
</section>

<!-- ============ AGENDA ============ -->
<section class="sec alt" id="agenda">
  <div class="wrap">
    <div class="sec-head">
      <div class="rv"><span class="eyebrow">Agenda</span><h2>Aprenda, conecte-se <span class="serif">e cresça.</span></h2></div>
      <div class="ag-links rv d1"><a href="/loja/cursos" class="btn btn-light">Todos os cursos <span class="arr">→</span></a><a href="/loja/eventos" class="btn btn-light">Todos os eventos <span class="arr">→</span></a></div>
    </div>
    <div class="ag-grid">
      @{ int nCard = 0; }
      @foreach (var a in agenda)
      {
        nCard++;
        <a class="ac rv d@(((nCard - 1) % 3) + 1)" href="@a.Url" target="@(a.Url.StartsWith("/") ? "_self" : "_blank")" rel="noopener">
          <div class="ac-cover @(a.Imagem == "" ? "noimg" : "")">@if (a.Imagem != "") {<img class="cv" src="@a.Imagem" alt="@a.Titulo" loading="lazy" decoding="async" onerror="this.parentNode.classList.add('noimg');this.remove()">}<div class="ac-chips"><span class="chip">@a.Tipo</span></div></div>
          <div class="ac-body">
            @if (a.Dia != "") {<div class="ac-date"><b>@a.Dia</b><span>@a.Mes</span></div>}
            <div class="ac-info"><h3>@a.Titulo</h3>@if (a.Detalhe != "") {<p>@a.Detalhe</p>}</div>
          </div>
          <div class="ac-foot"><span>Inscreva-se</span><i>→</i></div>
        </a>
      }
      @if (agenda.Count == 0)
      {
        <p class="nores">Nenhum curso ou evento com inscrições abertas no momento. Confira a <a href="https://loja.cdludi.org.br">Loja CDL</a>.</p>
      }
    </div>
    <a class="ag-ead rv" href="/loja/cursos-ead">
      <span class="chip">EAD</span><b>Cursos online da CDL</b><span class="ead-t">Estude no seu ritmo, com certificado</span><i>→</i>
    </a>
