<!-- ============ POR QUE SE ASSOCIAR (ref.: Mews / Attio) ============ -->
<section class="sec assoc" id="associe">
  <div class="wrap assoc-grid">
    <div class="assoc-side">
      <div class="rv"><span class="eyebrow">Para associados</span><h2>O que sua empresa <span class="serif">passa a ter.</span></h2>
      <p class="lead" style="margin-top:18px">A CDL recebe empresários, lojistas, prestadores de serviços e profissionais autônomos de Uberlândia.</p></div>
      <div class="mvv rv d1">
        <div><span>Missão</span><p>Fomentar o associativismo, influenciar o ambiente político-institucional e apoiar o desenvolvimento de nossos associados, compartilhando informações e soluções com credibilidade.</p></div>
        <div><span>Visão</span><p>Ser uma associação empresarial reconhecida pela excelência e representatividade, sendo referência para os associados, parceiros e comunidade.</p></div>
        <div><span>Valores</span><ul class="vals"><li>Coragem</li><li>Credibilidade</li><li>Determinação</li><li>Envolvimento</li><li>Ética</li><li>Inovação</li><li>Lisura</li><li>Sustentabilidade</li></ul></div>
      </div>
      <a href="/associe-se" class="btn btn-primary rv d2">Quero me associar <span class="arr">→</span></a>
    </div>
    <ol class="bn-list"><li class="bn rv"><span class="bn-n">/01</span><h3>Orientações gratuitas</h3><p>Jurídica, segurança digital, captação e retenção de clientes, recuperação de inadimplência, gestão de processos e análise de política de crédito.</p></li><li class="bn rv"><span class="bn-n">/02</span><h3>Soluções SPC</h3><p>SPC Consultas e Registro, SPC Avisa, SPC Conciliador, Certificado Digital e Cadastro Positivo.</p></li><li class="bn rv"><span class="bn-n">/03</span><h3>Gestão de pessoas e processos</h3><p>CDL Saúde, CDL Talentos, CDL Estágio, CDL Aprendiz, cursos, treinamento in company e consultoria em gestão e inovação.</p></li><li class="bn rv"><span class="bn-n">/04</span><h3>Relacionamento e capacitação</h3><p>Café Empreendedor, Feira de Oportunidades, HSM Online, Giro de Mercado, Jornada Empresarial e CDL Convenções e Eventos.</p></li><li class="bn rv"><span class="bn-n">/05</span><h3>Saúde financeira</h3><p>CDL Gestão e NF-e, cobrança e recuperação de crédito, parceria BDMG e parceria Sicredi.</p></li><li class="bn rv"><span class="bn-n">/06</span><h3>Marketing e vendas</h3><p>CDL Mídia, rede de descontos, pesquisas de mercado e campanhas promocionais.</p></li><li class="bn rv"><span class="bn-n">/07</span><h3>Representatividade</h3><p>Assessoria de imprensa e político-institucional, comunicados sobre deliberações municipais e CDL Direto.</p></li></ol>
  </div>
</section>

<!-- ============ AGENDA ============ -->
<section class="sec" id="agenda">
  <div class="wrap">
    <div class="sec-head">
      <div class="rv"><span class="eyebrow">Agenda</span><h2>Aprenda, conecte-se <span class="serif">e cresça.</span></h2></div>
      <div class="ag-links rv d1"><a href="/loja/cursos" class="btn btn-light">Todos os cursos <span class="arr">→</span></a><a href="/loja/eventos" class="btn btn-light">Todos os eventos <span class="arr">→</span></a></div>
    </div>
    <div class="ag-grid">
      @{ int nCard = 0; }
      @foreach (var a in agenda)
      {
        nCard++;
        <a class="ac rv d@(((nCard - 1) % 3) + 1)" href="@a.Url" target="@(a.Url.StartsWith("/") ? "_self" : "_blank")" rel="noopener">
          <div class="ac-cover @(a.Imagem == "" ? "noimg" : "")">@if (a.Imagem != "") {<img class="cv" src="@a.Imagem" alt="@a.Titulo" loading="lazy" decoding="async" onerror="this.parentNode.classList.add('noimg');this.remove()">}<div class="ac-chips"><span class="chip">@a.Tipo</span></div></div>
          <div class="ac-body">
            @if (a.Dia != "") {<div class="ac-date"><b>@a.Dia</b><span>@a.Mes</span></div>}
            <div class="ac-info"><h3>@a.Titulo</h3>@if (a.Detalhe != "") {<p>@a.Detalhe</p>}</div>
          </div>
          <div class="ac-foot"><span>Inscreva-se</span><i>→</i></div>
        </a>
      }
      @if (agenda.Count == 0)
      {
        <p class="nores">Nenhum curso ou evento com inscrições abertas no momento. Confira a <a href="https://loja.cdludi.org.br">Loja CDL</a>.</p>
      }
    </div>
    <a class="ag-ead rv" href="/loja/cursos-ead">
      <span class="chip">EAD</span><b>Cursos online da CDL</b><span class="ead-t">Estude no seu ritmo, com certificado</span><i>→</i>
    </a>
  </div>
</section>

