    @if (ViewBag.Cursos.Count > 0 || Model?.Cursos?.Where(x => x.DataInicio <= DateTime.Now && x.DataFim >= DateTime.Now).ToList().Count > 0)
    {
        <div class="container">
            <div class="mb-4 text-center">
                <span class="text-uppercase text-primary small font-weight-700 letter-spacing-1 mb-2 d-block">SE PROGRAME COM A</span>
                <h2 class="h1 mb-0"><a class="cursor-pointer text-dark" asp-route="Pages" asp-route-slug="cursos">Agenda de cursos CDL</a></h2>
                <div class="d-flex align-items-center justify-content-lg-end justify-content-center">
                    <div class="mt-2">
                        <a href="https://loja.cdludi.org.br/compras/cursos" class="text-body">Ver todos os cursos <i class="fas fa-arrow-right small ml-2"></i></a>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">

                @if (ViewBag.Cursos.Count > 0)
                {
                    /* Lista de Cursos cadastrados na Loja (vem da API) */

                    int i = 1;

                    foreach (var curso in ViewBag.Cursos)
                    {
                        @*    if (i > 3)
                        {
                            break;
                        } *@

                        string urlLandingPage = "";
                      
                        if (!string.IsNullOrWhiteSpace(curso.urlLandingPage.ToString()))
                        {
                            if (!curso.urlLandingPage.ToString().StartsWith("https://", StringComparison.OrdinalIgnoreCase) && !curso.urlLandingPage.ToString().StartsWith("http://", StringComparison.OrdinalIgnoreCase))
                            {
                                urlLandingPage = "https://" + curso.urlLandingPage;
                            }
                            else
                            {
                                urlLandingPage = curso.urlLandingPage;
                            }
                        }
                        else
                        {
                            urlLandingPage = "https://loja.cdludi.org.br/Compras/Produto/" + curso.slug;

                        }


                        <div class="col-md-6 col-lg-4 mb-1-9 mb-lg-0 mt-4">
                            <article class="card border-0 card-style4">

                                <div class="card border-0 border-radius-10 card-style3">
                                    <a href="@urlLandingPage" class="text-dark" target="_blank">

                                        <div class="card-img">
                                            <div class="card-img bg-img cover-background theme-overlay" style="min-height: 450px; margin-top: 0px !important; background-color: #0A3484; background-image: url('https://loja.cdludi.org.br/Anexos/servicos/@curso.codigo/@curso.imagem')" data-background="https://loja.cdludi.org.br/Anexos/servicos/@curso.codigo/@curso.imagem"></div>
                                            <span class="icon"><i class="fas fa-dollar-sign"></i></span>
                                        </div>
                                        <div class="card-body pb-2-0 pt-6 px-1-6 px-sm-2-6">
                                           

                                            <h3 class="h5 mb-3">
                                                <span class="text-dark">@curso.titulo</span>
                                            </h3>

                                            @if (!string.IsNullOrWhiteSpace(curso.dataInicioCurso.ToString()) && !string.IsNullOrWhiteSpace(curso.dataFimCurso.ToString()))
                                            {
                                                if (curso.dataInicioCurso == curso.dataFimCurso)
                                                {
                                                    <p class="mb-0">Dia @curso.dataInicioCurso</p>
                                                }
                                                else
                                                {
                                                    <p class="mb-0">De @curso.dataInicioCurso a @curso.dataFimCurso</p>
                                                }
                                            }

                                            @if (!string.IsNullOrWhiteSpace(curso.horaInicioCurso.ToString()) && !string.IsNullOrWhiteSpace(curso.horaFimCurso.ToString()))
                                            {
                                                if (curso.horaInicioCurso == curso.horaFimCurso)
                                                {
                                                    <p>@(curso.horaInicioCurso + "h")</p>
                                                }
                                                else
                                                {
                                                    <p>@(curso.horaInicioCurso + "h") às @(curso.horaFimCurso + "h")</p>
                                                }
                                            }

                                            <p style="margin-top:-10px"><strong>Curso Presencial</strong></p>

                                            @{
                                                string labelBotao = "Inscreva-se";

                                                // if (curso.gratuito == "N")
                                                // {
                                                //     if (!string.IsNullOrWhiteSpace(curso.valorunitario.ToString()))
                                                //     {
                                                //         labelBotao = "Compre Agora";
                                                //     }
                                                // }
                                            }

                                            <span class="butn md">@labelBotao</span>
                                        </div>
                                    </a>
                                </div>
                            </article>
                        </div>

                        i++;
                    }
                }
                
                @if (Model?.Cursos != null)
                {
                    /* Lista de posts da categoria "Cursos" e que não estão cadastrados na Loja */

                    int i = 1;

                    foreach (var cursoPost in Model.Cursos.Where(x => x.DataInicio <= DateTime.Now && x.DataFim >= DateTime.Now))
                    {
                  @*       if (i > 3)
                        {
                            break;
                        } *@

                        string urlLandingPage = "/publicacoes/cursos/" + cursoPost.Slug;

                        if (!string.IsNullOrWhiteSpace(cursoPost.Link))
                        {
                            if (!cursoPost.Link.StartsWith("https://", StringComparison.OrdinalIgnoreCase) && !cursoPost.Link.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
                            {
                                urlLandingPage = "https://" + cursoPost.Link;
                            }
                            else
                            {
                                urlLandingPage = cursoPost.Link;
                            }
                        }

                        <div class="col-md-6 col-lg-4 mb-1-9 mb-lg-0 mt-4">
                            <a href="@urlLandingPage" class="text-dark" target="_blank">
                                <article class="card border-0 card-style4">

                                    <div class="card border-0 border-radius-10 card-style3">
                                        <div class="card-img">
                                            <div class="card-img bg-img cover-background theme-overlay" style="min-height: 450px; margin-top: 0px !important; background-color: #0A3484; background-image: url('@(!string.IsNullOrWhiteSpace(cursoPost.Imagem) ? "/wp-content/uploads/" + cursoPost.Imagem : "/img/no-image.jpg")')" data-background="@(!string.IsNullOrWhiteSpace(cursoPost.Imagem) ? "/wp-content/uploads/" + cursoPost.Imagem : "/img/no-image.jpg")"></div>
                                            <span class="icon"><i class="fas fa-dollar-sign"></i></span>
                                        </div>
                                        <div class="card-body pb-2-0 pt-7 px-1-6 px-sm-2-6">

                                            <h3 class="h5 mb-3">
                                                <span class="text-dark">@cursoPost.Titulo</span>
                                            </h3>

                                            @if (!string.IsNullOrWhiteSpace(cursoPost.Subtitulo))
                                            {
                                                <p class="mb-0">@cursoPost.Subtitulo</p>
                                                <p></p>
                                            }

                                            <p><strong>Curso Presencial</strong></p>

                                            <span class="butn md">Inscreva-se</span>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        </div>

                        i++;
                    }
                }

            </div>
        </div>
    }

