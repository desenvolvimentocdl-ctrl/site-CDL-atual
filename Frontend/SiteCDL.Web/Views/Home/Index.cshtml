                        </div>

                        i++;
                    }
                }

                @if (Model?.Eventos != null)
                {
                    /* Lista de posts da categoria "Eventos" e que não estão cadastrados na Loja */

                    int i = 1;

                    foreach (var eventoPost in Model.Eventos.Where(x => x.DataInicio <= DateTime.Now && x.DataFim >= DateTime.Now))
                    {
                   @*      if (i > 3)
                        {
                            break;
                        }
 *@
                        string urlLandingPage = "/publicacoes/cursos/" + eventoPost.Slug;

                        if (!string.IsNullOrWhiteSpace(eventoPost.Link))
                        {
                            if (!eventoPost.Link.StartsWith("https://", StringComparison.OrdinalIgnoreCase) && !eventoPost.Link.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
                            {
                                urlLandingPage = "https://" + eventoPost.Link;
                            }
                            else
                            {
                                urlLandingPage = eventoPost.Link;
                            }
                        }

                        <div class="col-md-6 col-lg-4 mb-2-9 mb-lg-0 mt-4">
                            <article class="card border-0 card-style4">
                                <a href="@urlLandingPage" target="_blank">
                                    <div class="team-style2">
                                        <div class="card-img bg-img cover-background theme-overlay" style="min-height: 400px; margin-top: 0px !important; background-color: #0A3484; background-image: url('@(!string.IsNullOrWhiteSpace(eventoPost.Imagem) ? "/wp-content/uploads/" + eventoPost.Imagem : "/img/no-image.jpg")')" data-background="@(!string.IsNullOrWhiteSpace(eventoPost.Imagem) ? "/wp-content/uploads/" + eventoPost.Imagem : "/img/no-image.jpg")"></div>
                                        <div class="bg-white team-text py-4 position-relative text-left pl-4">
                                            <h3 class="h6 mb-1">@eventoPost.Titulo</h3>

                                            @if (!string.IsNullOrWhiteSpace(eventoPost.Subtitulo))
                                            {
                                                <span class="font-weight-600 small text-uppercase text-primary">@eventoPost.Subtitulo</span>
                                            }

                                            <br />

                                            <span class="butn md mt-3">Inscreva-se</span>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        </div>

                        i++;
                    }
                }
            </div>
        </div>
    }
     
